# Base URL of the FastAPI backend. Must include the scheme, no trailing slash.
#
# Defaults (when this is unset) already handle the common local-dev cases:
#   - Android emulator -> http://10.0.2.2:8000  (emulator's alias for host localhost)
#   - iOS simulator / web -> http://127.0.0.1:8000
#
# Set this explicitly when running on a physical device on the same
# Wi-Fi network as your dev machine, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000
EXPO_PUBLIC_API_BASE_URL=
