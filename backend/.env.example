# Copy to backend/.env and fill in. Never commit the real .env.

# Postgres in production; defaults to sqlite:///./dev.db when unset.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API (the deployed frontend).
CORS_ORIGINS=

# AES-256 key for encrypting sensitive columns at rest. Generate with:
#   python -m app.crypto
# Losing this key makes all encrypted data unrecoverable -- back it up.
DATA_ENCRYPTION_KEY=

# true in production: redirect HTTP -> HTTPS and send HSTS.
FORCE_HTTPS=

N8N_WEBHOOK_URL=
